{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "strict": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["test/**/*.test.mjs"],
  "exclude": ["dist", "node_modules"]
}
