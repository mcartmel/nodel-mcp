NODEL_BASE_URL=http://127.0.0.1:8085
MCP_PORT=8765
MCP_BIND_ADDRESS=127.0.0.1
# Optional inbound bearer token required by /mcp when set.
NODEL_MCP_TOKEN=
# Exact comma-separated browser origins. Empty allows no browser Origin values.
MCP_ALLOWED_ORIGINS=
# Trust X-Request-Id only when a trusted reverse proxy has already sanitized it.
MCP_TRUST_REQUEST_ID_HEADER=false
# Exact comma-separated origins permitted for explicit runtimeUrl operations.
NODEL_ALLOWED_RUNTIME_ORIGINS=
# Maximum JSON request body in bytes. Base64 fields expand payload size.
MCP_REQUEST_BODY_LIMIT_BYTES=1048576
# Bound graceful HTTP/MCP shutdown before remaining sockets are force-closed.
MCP_SHUTDOWN_TIMEOUT_MS=10000
# Comma-separated prefixes. Empty means every node is visible for read-only tools.
NODEL_ALLOWED_NODE_PREFIXES=
# Local sidecar state for approvals, audit logs, and binding/parameter backups.
NODEL_STATE_DIR=.state
# Writes/actions are disabled by default. Enable only during approved maintenance.
NODEL_ENABLE_WRITES=false
# Node create/restart lifecycle operations require this in addition to writes.
NODEL_ENABLE_NODE_LIFECYCLE=false
# Node deletion requires writes, lifecycle, and this explicit delete gate.
NODEL_ENABLE_DELETES=false
# Write tools require a short-lived approval id by default.
NODEL_REQUIRE_WRITE_APPROVAL=true
# Approval ids expire after this many seconds.
NODEL_WRITE_APPROVAL_TTL_SECONDS=600
# Minimum delay after recipe or parameter writes before readiness probes begin.
NODEL_POST_WRITE_SETTLE_MS=3000
# Maximum time recipe and parameter write tools wait for the node REST API to become ready.
NODEL_POST_WRITE_READY_TIMEOUT_SECONDS=20
# Per-request timeout for Nodel REST calls made by the sidecar.
NODEL_REQUEST_TIMEOUT_MS=10000
# Per-request timeout for public recipe GitHub calls.
PUBLIC_RECIPE_REQUEST_TIMEOUT_MS=15000
# Rotate audit JSONL files at 10 MiB and retain five files.
NODEL_AUDIT_MAX_BYTES=10485760
NODEL_AUDIT_RETENTION_FILES=5
# Retain backups for 30 days, with at most 50 per node and kind.
NODEL_BACKUP_RETENTION_DAYS=30
NODEL_BACKUP_RETENTION_PER_NODE_KIND=50
